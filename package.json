{
  "name": "bogota-al-dia",
  "version": "1.1.0",
  "type": "module",
  "description": "Datos públicos del día a día en Bogotá, abiertos y listos para agentes",
  "bin": {
    "bogota": "bin/bogota.mjs"
  },
  "files": [
    "bin",
    "lib",
    "data"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run extract && astro build",
    "preview": "astro preview",
    "extract": "pnpm run extract:estaciones && pnpm run extract:rutas && pnpm run extract:recoleccion",
    "extract:estaciones": "tsx scripts/extract-estaciones.ts",
    "extract:rutas": "tsx scripts/extract-rutas.ts",
    "extract:recoleccion": "tsx scripts/extract-recoleccion.ts",
    "validate": "tsx scripts/validate-data.ts",
    "test": "node --test lib/*.test.mjs",
    "test:mcp": "tsx scripts/mcp-compat.mjs",
    "lint": "eslint . --ext .ts,.astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "astro": "^4.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/node": "^23.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
