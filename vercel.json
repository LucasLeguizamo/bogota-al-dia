{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/api/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "RateLimit-Policy",
          "value": "\"default\";q=600;w=60"
        },
        {
          "key": "RateLimit",
          "value": "\"default\";r=600;t=60"
        },
        {
          "key": "API-Version",
          "value": "v1"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/acerca/"
    },
    {
      "source": "/contact",
      "destination": "/contacto/"
    },
    {
      "source": "/privacy",
      "destination": "/privacidad/"
    }
  ]
}