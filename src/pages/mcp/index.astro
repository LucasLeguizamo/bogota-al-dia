---
import Layout from '../../layouts/Layout.astro';
import { TOOL_DEFS, CLI_COMMANDS, PLUGIN_INSTALL, MCP_ADD_HTTP, PROTOCOL_VERSIONS } from '../../lib/agentes';

const cliUso = CLI_COMMANDS.map(([c, d]) => `${c.padEnd(52)} # ${d}`).join('\n');

const ejemploBuscarEstacion = `curl -X POST https://bogota-al-dia.vercel.app/api/mcp \\
  -H "Content-Type: application/json" \\
  -d '{
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "estaciones_transmilenio",
      "arguments": { "query": "portal" }
    }
  }'`;

const ejemploRecoleccion = `curl -X POST https://bogota-al-dia.vercel.app/api/mcp \\
  -H "Content-Type: application/json" \\
  -d '{
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "recoleccion_por_zona",
      "arguments": { "localidad": "suba" }
    }
  }'`;

const ejemploListTools = `curl -X POST https://bogota-al-dia.vercel.app/api/mcp \\
  -H "Content-Type: application/json" \\
  -d '{"jsonrpc": "2.0", "id": 1, "method": "tools/list"}'`;
---

<Layout 
  title="MCP Server" 
  description="Model Context Protocol server para agentes de IA. Herramientas para consultar datos de TransMilenio y recolección en Bogotá.">
  
  <h1>MCP Server</h1>
  <p>Servidor Model Context Protocol (MCP) para agentes de IA.</p>
  
  <section aria-labelledby="conexion-heading">
    <h2 id="conexion-heading">Conexión</h2>
    <div class="card">
      <p><strong>Endpoint:</strong> <code>https://bogota-al-dia.vercel.app/api/mcp</code></p>
      <p><strong>Protocolo:</strong> MCP Streamable HTTP (JSON-RPC 2.0 por POST, sin sesiones)</p>
      <p><strong>Versiones:</strong> {PROTOCOL_VERSIONS.join(', ')}</p>
      <p><strong>Autenticación:</strong> No requerida</p>
      <p>
        <a href="/server.json">server.json</a> · 
        <a href="/mcp/server-card.json">server-card.json</a>
      </p>
    </div>
  </section>
  
  <section aria-labelledby="instalar-heading">
    <h2 id="instalar-heading">Cómo usarlo</h2>

    <article class="card">
      <h3>Plugin de Claude Code</h3>
      <p>Servidor MCP local sin dependencias, agentes expertos y skill.</p>
      <pre><code>{PLUGIN_INSTALL}</code></pre>
    </article>

    <article class="card">
      <h3>MCP remoto</h3>
      <pre><code>{MCP_ADD_HTTP}</code></pre>
    </article>

    <article class="card">
      <h3>MCP local (stdio)</h3>
      <p>Desde un clon del repositorio, solo con Node:</p>
      <pre><code>node bin/bogota.mjs mcp</code></pre>
    </article>

    <article class="card">
      <h3>CLI</h3>
      <p>Mismos datos en la terminal, salida JSON (<code>bogota</code> = <code>node bin/bogota.mjs</code>):</p>
      <pre><code>{cliUso}</code></pre>
    </article>
  </section>

  <section aria-labelledby="herramientas-heading">
    <h2 id="herramientas-heading">Herramientas disponibles ({TOOL_DEFS.length})</h2>
    {TOOL_DEFS.map((t) => {
      const params = Object.entries(t.inputSchema.properties);
      return (
        <article class="card">
          <h3>{t.name}</h3>
          <p>{t.description}</p>
          <p>
            <strong>Parámetros:</strong>{' '}
            {params.length ? params.map(([k, p]) => `${k} (${p.type}, opcional): ${p.description}`).join(' · ') : 'ninguno'}
          </p>
        </article>
      );
    })}
  </section>

  <section aria-labelledby="ejemplos-heading">
    <h2 id="ejemplos-heading">Ejemplos</h2>
    
    <article class="card">
      <h3>Listar herramientas</h3>
      <pre><code>{ejemploListTools}</code></pre>
    </article>
    
    <article class="card">
      <h3>Buscar estaciones</h3>
      <pre><code>{ejemploBuscarEstacion}</code></pre>
    </article>
    
    <article class="card">
      <h3>Consultar recolección</h3>
      <pre><code>{ejemploRecoleccion}</code></pre>
    </article>
  </section>
  
  <section aria-labelledby="recursos-heading">
    <h2 id="recursos-heading">Recursos</h2>
    <div class="card">
      <ul>
        <li><a href="/server.json">server.json - MCP Server Manifest</a></li>
        <li><a href="/mcp/server-card.json">server-card.json - Server Card</a></li>
        <li><a href="/.well-known/mcp/server-card.json">.well-known/mcp/server-card.json</a></li>
        <li><a href="/openapi.json">OpenAPI Specification</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  pre {
    background: #1e3a5f;
    color: #a8dadc;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    font-size: 0.75rem;
    white-space: pre-wrap;
    word-break: break-all;
  }
  code {
    font-family: 'SF Mono', Monaco, Consolas, monospace;
  }
</style>
