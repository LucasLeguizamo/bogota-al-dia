---
import Layout from '../../layouts/Layout.astro';

const ejemploBuscarEstacion = `{
  "name": "buscar_estacion",
  "arguments": {
    "query": "Portal Suba"
  }
}`;

const ejemploBuscarRuta = `{
  "name": "buscar_ruta",
  "arguments": {
    "codigo": "B23"
  }
}`;

const ejemploRecoleccion = `{
  "name": "horario_recoleccion",
  "arguments": {
    "localidad": "Suba"
  }
}`;

const ejemploConfig = `{
  "mcpServers": {
    "bogota-al-dia": {
      "url": "https://bogota-al-dia.vercel.app/mcp"
    }
  }
}`;
---

<Layout 
  title="MCP Server" 
  description="Model Context Protocol server para agentes de IA. Herramientas para consultar datos de TransMilenio y recolección en Bogotá.">
  
  <h1>MCP Server</h1>
  <p>Servidor Model Context Protocol (MCP) para agentes de IA.</p>
  
  <section aria-labelledby="conexion-heading">
    <h2 id="conexion-heading">Conexión</h2>
    <div class="card">
      <p><strong>Endpoint:</strong> <code>https://bogota-al-dia.vercel.app/mcp</code></p>
      <p><strong>Protocolo:</strong> Streamable HTTP</p>
      <p><strong>Autenticación:</strong> No requerida</p>
      <p><a href="/server.json">Ver server.json →</a></p>
    </div>
  </section>
  
  <section aria-labelledby="herramientas-heading">
    <h2 id="herramientas-heading">Herramientas Disponibles</h2>
    
    <article class="card">
      <h3>buscar_estacion</h3>
      <p>Busca una estación de TransMilenio por nombre o código.</p>
      <pre><code>{ejemploBuscarEstacion}</code></pre>
    </article>
    
    <article class="card">
      <h3>buscar_ruta</h3>
      <p>Busca una ruta de TransMilenio por código.</p>
      <pre><code>{ejemploBuscarRuta}</code></pre>
    </article>
    
    <article class="card">
      <h3>horario_recoleccion</h3>
      <p>Consulta horarios de recolección de basura por localidad.</p>
      <pre><code>{ejemploRecoleccion}</code></pre>
    </article>
    
    <article class="card">
      <h3>listar_localidades</h3>
      <p>Lista todas las localidades de Bogotá con información de recolección.</p>
    </article>
  </section>
  
  <section aria-labelledby="ejemplo-heading">
    <h2 id="ejemplo-heading">Ejemplo de Uso</h2>
    <div class="card">
      <p>Configuración para Claude Desktop (config.json):</p>
      <pre><code>{ejemploConfig}</code></pre>
    </div>
  </section>
  
  <section aria-labelledby="recursos-heading">
    <h2 id="recursos-heading">Recursos</h2>
    <div class="card">
      <ul>
        <li><a href="/server.json">server.json - MCP Server Manifest</a></li>
        <li><a href="/.well-known/mcp/server-card.json">server-card.json</a></li>
        <li><a href="/openapi.json">OpenAPI Specification</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  pre {
    background: #1e3a5f;
    color: #a8dadc;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    font-size: 0.875rem;
  }
  code {
    font-family: 'SF Mono', Monaco, Consolas, monospace;
  }
</style>
